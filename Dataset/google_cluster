"""
datasets/google_cluster/preprocess.py

Google Cluster 2011 Trace → SHADE Task Descriptor Mapping.

Maps Google Cluster job records to SHADE task descriptor format:
    τᵢ = ⟨cpuᵢ, memᵢ, dᵢ, pᵢ, szᵢ, tpᵢ⟩

Mapping rules (Section 6.2 of paper):
  - cpu_i    ← Google field "cpu_requested" (already normalized 0–1)
  - mem_i    ← Google field "memory_requested" (already normalized 0–1)
  - d_i      ← SYNTHETIC: 1.5 × E[T_exec(τᵢ, assigned class)]
               (Google trace has no SLA deadlines)
  - p_i      ← Google field "scheduling_class" (0–3 priority levels)
  - sz_i     ← Derived from "memory_requested" × "cpu_requested" as proxy
  - tp_i     ← Inferred from CPU-to-memory request ratio:
               ratio > 4   → compute_intensive
               ratio < 0.5 → memory_intensive (mapped to storage_heavy)
               gpu_req > 0 → gpu_accelerated
               else        → latency_sensitive

Source: Google Cluster Data v3, released 2011.
Download: https://github.com/google/cluster-data

Reference: Section 6.2 of paper.
"""

import numpy as np
import pandas as pd
from pathlib import Path
from typing import Optional, List, Dict
import warnings


# Google Cluster field names (task_events table, v3 format)
GOOGLE_FIELDS = {
    'timestamp': 0,
    'missing_info': 1,
    'job_id': 2,
    'task_index': 3,
    'machine_id': 4,
    'event_type': 5,
    'username': 6,
    'scheduling_class': 7,
    'priority': 8,
    'cpu_requested': 9,
    'memory_requested': 10,
    'disk_space_requested': 11,
    'machine_constraint': 12,
}

# Task type classification thresholds
CPU_MEM_RATIO_THRESHOLDS = {
    'compute_intensive': 4.0,    # cpu/mem ratio > 4
    'storage_heavy': 0.5,        # cpu/mem ratio < 0.5
}

# Deadline multiplier: d_i = DEADLINE_FACTOR × E[T_exec]
DEADLINE_FACTOR = 1.5

# Mean execution time estimates per task type (seconds, from trace analysis)
MEAN_EXEC_TIME = {
    'compute_intensive': 120.0,
    'latency_sensitive': 5.0,
    'gpu_accelerated': 60.0,
    'storage_heavy': 300.0,
}


def classify_task_type(
    cpu_requested: float,
    memory_requested: float,
    disk_requested: float = 0.0,
    gpu_requested: float = 0.0,
) -> str:
    """
    Infer SHADE task type from Google Cluster resource request fields.

    Args:
        cpu_requested: Normalized CPU request (0–1 of machine capacity).
        memory_requested: Normalized memory request (0–1 of machine capacity).
        disk_requested: Normalized disk request (0–1).
        gpu_requested: GPU resource request (> 0 if GPU needed).

    Returns:
        task_type: One of {compute_intensive, latency_sensitive,
                           gpu_accelerated, storage_heavy}.
    """
    # GPU tasks (if GPU resource field is available)
    if gpu_requested > 0.0:
        return 'gpu_accelerated'

    # CPU-to-memory ratio as proxy for task computational profile
    ratio = cpu_requested / (memory_requested + 1e-8)

    if ratio > CPU_MEM_RATIO_THRESHOLDS['compute_intensive']:
        return 'compute_intensive'
    elif ratio < CPU_MEM_RATIO_THRESHOLDS['storage_heavy'] and disk_requested > 0.1:
        return 'storage_heavy'
    else:
        return 'latency_sensitive'


def assign_synthetic_deadline(
    task_type: str,
    cpu_requested: float,
    deadline_factor: float = DEADLINE_FACTOR,
) -> float:
    """
    Assign synthetic SLA deadline (d_i) to Google Cluster tasks.

    The Google Cluster trace contains no SLA deadlines. Deadlines are
    synthetically assigned as:
        d_i = deadline_factor × E[T_exec(τᵢ, assigned class)]

    This places the deadline at 50% above expected completion time —
    a conservative SLA threshold consistent with production IoT QoS practice.
    The factor 1.5 ensures ~96% of tasks can meet the deadline under
    normal load, exercising the SLA violation metric meaningfully.

    Args:
        task_type: Inferred task type.
        cpu_requested: CPU request (scales execution time estimate).
        deadline_factor: Multiplier over mean execution time (default 1.5).

    Returns:
        deadline: Synthetic SLA deadline in milliseconds.
    """
    base_exec = MEAN_EXEC_TIME.get(task_type, 60.0)

    # Heavier CPU requests increase expected execution time on edge nodes
    # (Class A–B nodes are slower; we model this conservatively)
    cpu_factor = 1.0 + cpu_requested * 2.0  # range [1.0, 3.0]

    deadline_s = deadline_factor * base_exec * cpu_factor
    deadline_ms = deadline_s * 1000  # Convert to milliseconds

    # Clip to SHADE deadline range [50, 500] ms for short tasks
    # For long-running jobs (> 500ms), keep the full deadline
    return float(deadline_ms)


def preprocess_google_cluster(
    input_path: str,
    output_path: str,
    max_tasks: Optional[int] = None,
    event_type_filter: int = 1,  # 1 = task scheduled event
    seed: int = 42,
) -> pd.DataFrame:
    """
    Preprocess Google Cluster 2011 trace to SHADE task descriptor format.

    Args:
        input_path: Path to raw Google Cluster CSV files (task_events/).
        output_path: Path to save processed Parquet file.
        max_tasks: Maximum tasks to process (None = all ~700,000).
        event_type_filter: Event type to filter (1 = SCHEDULE events).
        seed: Random seed for reproducibility.

    Returns:
        df: DataFrame with SHADE task descriptor columns.
    """
    np.random.seed(seed)
    input_dir = Path(input_path)
    output_dir = Path(output_path)
    output_dir.mkdir(parents=True, exist_ok=True)

    # Load Google Cluster task event files
    csv_files = sorted(input_dir.glob('part-*.csv.gz'))
    if not csv_files:
        csv_files = sorted(input_dir.glob('*.csv'))

    if not csv_files:
        raise FileNotFoundError(
            f"No Google Cluster CSV files found in {input_path}.\n"
            f"Download from: https://github.com/google/cluster-data\n"
            f"Expected pattern: part-????-of-????.csv.gz"
        )

    print(f"Found {len(csv_files)} Google Cluster files")

    records = []
    total_loaded = 0

    for csv_file in csv_files:
        try:
            df_raw = pd.read_csv(
                csv_file,
                header=None,
                names=list(GOOGLE_FIELDS.keys()),
                compression='gzip' if str(csv_file).endswith('.gz') else None,
            )
        except Exception as e:
            warnings.warn(f"Could not read {csv_file}: {e}")
            continue

        # Filter to SCHEDULE events only
        df_sched = df_raw[df_raw['event_type'] == event_type_filter].copy()

        # Drop rows with missing CPU/memory requests
        df_sched = df_sched.dropna(subset=['cpu_requested', 'memory_requested'])
        df_sched = df_sched[
            (df_sched['cpu_requested'] > 0) &
            (df_sched['memory_requested'] > 0)
        ]

        for _, row in df_sched.iterrows():
            cpu_i = float(row['cpu_requested'])
            mem_i = float(row['memory_requested'])
            disk_i = float(row.get('disk_space_requested', 0.0) or 0.0)
            priority_raw = int(row.get('scheduling_class', 0) or 0)

            # Infer task type
            tp_i = classify_task_type(cpu_i, mem_i, disk_i)

            # Assign synthetic deadline
            d_i = assign_synthetic_deadline(tp_i, cpu_i)

            # Priority: scheduling_class 0–3 mapped to [0, 1] priority
            p_i = priority_raw / 3.0

            # Size proxy: CPU × memory product (relative data volume)
            sz_i = float(cpu_i * mem_i)

            records.append({
                # SHADE task descriptor τᵢ
                'cpu_i': cpu_i,
                'mem_i': mem_i,
                'deadline_ms': d_i,
                'priority': p_i,
                'size': sz_i,
                'task_type': tp_i,
                # Metadata (for analysis)
                'job_id': int(row['job_id']),
                'task_index': int(row['task_index']),
                'timestamp_us': int(row['timestamp']),
                'scheduling_class': priority_raw,
            })

            total_loaded += 1
            if max_tasks and total_loaded >= max_tasks:
                break

        print(f"  Loaded {total_loaded:,} tasks from {csv_file.name}")
        if max_tasks and total_loaded >= max_tasks:
            break

    df = pd.DataFrame(records)

    # Print summary statistics
    print(f"\n{'='*50}")
    print(f"Google Cluster preprocessing complete")
    print(f"  Total tasks: {len(df):,}")
    print(f"  Task type distribution:")
    print(df['task_type'].value_counts(normalize=True).mul(100).round(1).to_string())
    print(f"  Deadline range: [{df['deadline_ms'].min():.0f}, "
          f"{df['deadline_ms'].max():.0f}] ms")
    print(f"  CPU range: [{df['cpu_i'].min():.3f}, {df['cpu_i'].max():.3f}]")
    print(f"  Memory range: [{df['mem_i'].min():.3f}, {df['mem_i'].max():.3f}]")

    # Save processed data
    output_file = output_dir / 'google_cluster_processed.parquet'
    df.to_parquet(output_file, index=False)
    print(f"\nSaved to: {output_file}")

    return df


if __name__ == '__main__':
    import argparse

    parser = argparse.ArgumentParser(
        description='Preprocess Google Cluster 2011 trace for SHADE'
    )
    parser.add_argument(
        '--input', required=True,
        help='Path to raw Google Cluster CSV directory'
    )
    parser.add_argument(
        '--output', default='data/processed/google_cluster/',
        help='Output directory for processed Parquet file'
    )
    parser.add_argument(
        '--max_tasks', type=int, default=None,
        help='Maximum number of tasks to process (default: all)'
    )
    parser.add_argument('--seed', type=int, default=42)

    args = parser.parse_args()
    preprocess_google_cluster(args.input, args.output, args.max_tasks, seed=args.seed)
