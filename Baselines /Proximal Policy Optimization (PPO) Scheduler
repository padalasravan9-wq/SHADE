"""
baselines/drl/ppo.py

Proximal Policy Optimization (PPO) Scheduler — DRL Baseline.

Implements the PPO scheduling approach from:
    Zhan, Z-H., et al. (2020). Deep reinforcement learning for task
    offloading in mobile edge computing.
    IEEE Internet of Things Journal. [Reference 9 in paper]

Key structural difference from SHADE:
    - Flat homogeneous state vector (same as DDQN)
    - Actor-Critic architecture with clipped surrogate objective
    - No device-class capability encoding
    - Training instability under workload distribution shift
      (documented in Section 2.2 of paper)

PPO uses the same HomogeneousStateEncoder as DDQN — the flat
[cpu_util, queue_depth] representation that cannot distinguish
Class A from Class D node capabilities.

Paper result (Table 5):
    Latency: 23.2 ± 0.9 ms (vs SHADE: 18.4 ± 0.5 ms, −20.7%)
    Affinity: 0.67 (vs SHADE: 0.89, +0.22)

Reference: Section 6.3, [9] in paper.
"""

import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from torch.distributions import Categorical
from typing import List, Dict, Optional, Tuple


class PPOActorCritic(nn.Module):
    """
    Shared-backbone Actor-Critic network for PPO scheduling.

    Both policy (actor) and value function (critic) share the first
    two hidden layers, with separate output heads.
    """

    def __init__(self, state_dim: int, n_actions: int, hidden_dim: int = 256):
        super().__init__()

        # Shared backbone
        self.shared = nn.Sequential(
            nn.Linear(state_dim, hidden_dim),
            nn.Tanh(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.Tanh(),
        )

        # Actor head: policy logits
        self.actor = nn.Linear(hidden_dim, n_actions)

        # Critic head: state value estimate
        self.critic = nn.Linear(hidden_dim, 1)

        # Initialize output layers with small weights (PPO standard)
        nn.init.orthogonal_(self.actor.weight, gain=0.01)
        nn.init.orthogonal_(self.critic.weight, gain=1.0)

    def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        shared = self.shared(x)
        logits = self.actor(shared)
        value = self.critic(shared).squeeze(-1)
        return logits, value

    def get_action(
        self,
        x: torch.Tensor,
    ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        logits, value = self.forward(x)
        dist = Categorical(logits=logits)
        action = dist.sample()
        log_prob = dist.log_prob(action)
        return action, log_prob, value


class PPOScheduler:
    """
    PPO scheduler with clipped surrogate objective.

    Implements the approach from Zhan et al. [9] using a flat
    homogeneous state representation — the same representation
    limitation as DDQN. PPO's advantage over DDQN is greater
    training stability under continuous action spaces, but in the
    discrete scheduling setting both methods are limited by the
    absence of capability information in the state.

    Training uses the same budget as SHADE: 50,000 environment steps.
    """

    def __init__(
        self,
        n_nodes: int,
        gamma: float = 0.99,
        lr: float = 3e-4,
        clip_epsilon: float = 0.2,
        n_epochs: int = 4,
        gae_lambda: float = 0.95,
        value_coef: float = 0.5,
        entropy_coef: float = 0.01,
    ):
        self.name = 'PPO'
        self.n_nodes = n_nodes
        self.gamma = gamma
        self.clip_epsilon = clip_epsilon
        self.n_epochs = n_epochs
        self.gae_lambda = gae_lambda
        self.value_coef = value_coef
        self.entropy_coef = entropy_coef

        # Flat homogeneous state: N×2 + 2 task features
        self.state_dim = n_nodes * 2 + 2
        self.n_actions = n_nodes

        self.ac_net = PPOActorCritic(self.state_dim, self.n_actions)
        self.optimizer = optim.Adam(self.ac_net.parameters(), lr=lr)

        # Rollout buffer
        self.states: list = []
        self.actions: list = []
        self.log_probs: list = []
        self.rewards: list = []
        self.values: list = []
        self.dones: list = []

        self.steps = 0
        self._encode = __import__(
            'baselines.drl.ddqn', fromlist=['HomogeneousStateEncoder']
        ).HomogeneousStateEncoder()

    def select_node(
        self,
        task: Dict,
        nodes: List[Dict],
        training: bool = False,
    ) -> int:
        """
        Select node by sampling from the policy distribution.

        At inference (training=False), uses the greedy argmax action
        (deterministic policy) for fair comparison with other methods.
        """
        state = self._encode.encode(task, nodes)
        state_t = torch.tensor(state, dtype=torch.float32).unsqueeze(0)

        if training:
            action, log_prob, value = self.ac_net.get_action(state_t)
            self.states.append(state)
            self.actions.append(action.item())
            self.log_probs.append(log_prob.item())
            self.values.append(value.item())
            self.steps += 1
            return action.item()
        else:
            with torch.no_grad():
                logits, _ = self.ac_net(state_t)
                return int(logits.argmax(dim=1).item())

    def store_reward(self, reward: float, done: bool):
        self.rewards.append(reward)
        self.dones.append(done)

    def update(self) -> Optional[float]:
        """
        PPO update with clipped surrogate objective.

        Performs n_epochs passes over the collected rollout buffer.
        Clips the probability ratio to prevent large policy updates
        that destabilize training.
        """
        if len(self.rewards) == 0:
            return None

        # Compute GAE advantages
        advantages = self._compute_gae()
        returns = advantages + torch.tensor(self.values, dtype=torch.float32)
        advantages = (advantages - advantages.mean()) / (advantages.std() + 1e-8)

        states_t = torch.tensor(np.array(self.states), dtype=torch.float32)
        actions_t = torch.tensor(self.actions, dtype=torch.long)
        old_log_probs_t = torch.tensor(self.log_probs, dtype=torch.float32)

        total_loss = 0.0
        for _ in range(self.n_epochs):
            logits, values = self.ac_net(states_t)
            dist = Categorical(logits=logits)
            new_log_probs = dist.log_prob(actions_t)
            entropy = dist.entropy().mean()

            # PPO clipped surrogate objective
            ratio = torch.exp(new_log_probs - old_log_probs_t)
            surr1 = ratio * advantages
            surr2 = torch.clamp(ratio, 1 - self.clip_epsilon, 1 + self.clip_epsilon) * advantages
            actor_loss = -torch.min(surr1, surr2).mean()

            # Value function loss
            critic_loss = nn.MSELoss()(values, returns)

            loss = actor_loss + self.value_coef * critic_loss - self.entropy_coef * entropy
            self.optimizer.zero_grad()
            loss.backward()
            torch.nn.utils.clip_grad_norm_(self.ac_net.parameters(), 0.5)
            self.optimizer.step()
            total_loss += loss.item()

        # Clear rollout buffer
        self.states.clear()
        self.actions.clear()
        self.log_probs.clear()
        self.rewards.clear()
        self.values.clear()
        self.dones.clear()

        return total_loss / self.n_epochs

    def _compute_gae(self) -> torch.Tensor:
        """Generalized Advantage Estimation."""
        advantages = []
        gae = 0.0
        values = self.values + [0.0]  # Bootstrap with 0 for terminal

        for t in reversed(range(len(self.rewards))):
            delta = (
                self.rewards[t]
                + self.gamma * values[t + 1] * (1 - self.dones[t])
                - values[t]
            )
            gae = delta + self.gamma * self.gae_lambda * (1 - self.dones[t]) * gae
            advantages.insert(0, gae)

        return torch.tensor(advantages, dtype=torch.float32)

    def reset(self):
        self.steps = 0
        self.states.clear()
        self.actions.clear()
        self.log_probs.clear()
        self.rewards.clear()
        self.values.clear()
        self.dones.clear()
